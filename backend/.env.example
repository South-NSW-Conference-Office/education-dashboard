# Copy to .env.local. Local MongoDB, no auth (phase 1).
MONGODB_URI=mongodb://127.0.0.1:27017/snsw_dashboard

# ---- Portal SSO (login-adventistbot) — off by default -----------------------
# With AUTH_SSO_ENABLED unset/false the app runs as an open local tool, exactly
# as before SSO existed. With it on, sign-in happens only through the portal and
# every /api/v1 route needs a session plus the portal's app-access verdict.
#AUTH_SSO_ENABLED=true

# The one origin the BROWSER sees (the SPA host, which proxies /api here) —
# cookie anchor, OAuth callback origin and redirect base all at once.
#BETTER_AUTH_URL=http://localhost:5173
#BETTER_AUTH_SECRET=generate-a-long-random-string

# OAuth client minted by the portal's seed:apps for the education-dashboard app.
# NEVER reuse a local dev client id/secret in production — read production's
# from its own oauthClient collection.
#AUTH_SSO_CLIENT_ID=
#AUTH_SSO_CLIENT_SECRET=
#AUTH_SSO_DISCOVERY_URL=http://localhost:3000/.well-known/openid-configuration

# The portal's browser-facing origin — the sidebar's "Portal" link.
#PORTAL_URL=http://localhost:3000

# Central authorization authority: the portal's /internal/app-access endpoint.
# The credential is registered in the portal backend's APP_ACCESS_CLIENTS and is
# bound there to this app and one organization.
#APP_ACCESS_URL=http://localhost:4100/internal/app-access
#APP_ACCESS_CLIENT_ID=education-<orgId>
#APP_ACCESS_SECRET=same-secret-as-the-portal-client
