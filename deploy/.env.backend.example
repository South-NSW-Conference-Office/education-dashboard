# Production backend environment — lives at
# /home/morpheus/education-dashboard/.env.backend on morpheus, placed there
# once by hand and gitignored. CI never writes it.

# Dedicated Mongo user, readWrite scoped to ONLY this database on morpheus's
# host mongod (reached from the container over host.docker.internal).
MONGODB_URI=mongodb://education_dashboard:CHANGE_ME@host.docker.internal:27017/education_dashboard?tls=true&tlsAllowInvalidCertificates=true&authSource=education_dashboard

# ---- Portal SSO (login-adventistbot) ----------------------------------------
AUTH_SSO_ENABLED=true
# The one origin the BROWSER sees (the frontend on snswserver, which proxies
# /api here): cookie anchor, OAuth callback origin and redirect base at once.
BETTER_AUTH_URL=https://education.adventist.bot
BETTER_AUTH_SECRET=CHANGE_ME_LONG_RANDOM

# OAuth client minted by the production portal's seed:apps for the
# education-dashboard app. Read from the production oauthClient collection —
# NEVER a local dev .env's values.
AUTH_SSO_CLIENT_ID=CHANGE_ME
AUTH_SSO_CLIENT_SECRET=CHANGE_ME
AUTH_SSO_DISCOVERY_URL=https://portal.adventist.bot/.well-known/openid-configuration
PORTAL_URL=https://portal.adventist.bot

# Central authorization authority: the portal backend on this same host, over
# the tailnet binding. The credential is registered in the portal backend's
# APP_ACCESS_CLIENTS and bound there to this app + the SNSW organization.
APP_ACCESS_URL=http://100.87.6.30:4100/internal/app-access
APP_ACCESS_CLIENT_ID=education-CHANGE_ME_ORG_ID
APP_ACCESS_SECRET=CHANGE_ME_SAME_AS_PORTAL_CLIENT
